{
  "name": "agendamiento-instalaciones",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "demo:concurrencia": "tsx scripts/demo-concurrencia.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "next": "15.5.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.55.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "17.2.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "prisma": "6.16.2",
    "tsx": "4.20.5",
    "typescript": "^5",
    "vitest": "3.2.4"
  },
  "allowScripts": {
    "prisma@6.16.2": true,
    "@prisma/client@6.16.2": true,
    "@prisma/engines@6.16.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "sharp": false
  }
}
