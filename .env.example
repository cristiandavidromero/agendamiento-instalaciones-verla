# Base de desarrollo (docker-compose expone PostgreSQL en el puerto 5433)
DATABASE_URL="postgresql://agenda:agenda@localhost:5433/agenda?schema=public"

# Base de pruebas de integración; connection_limit alto para la prueba de 20 ventas simultáneas
DATABASE_URL_TEST="postgresql://agenda:agenda@localhost:5433/agenda_test?schema=public&connection_limit=30"
